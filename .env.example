# EXAMPLE SETTINGS ONLY. This file is public and the app does not load it.
#
# For local use, copy it to .env (which git ignores):
#     cp .env.example .env
#
# For production, you MUST replace JWT_SECRET with your own random value. Anyone who
# knows the value can forge login tokens, including admin ones. To generate one:
#     openssl rand -base64 48
#
# On a host such as Vercel, set these in the project's environment variables instead.

# Environment variables declared in .env are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

BCRYPT_SALT_ROUNDS=10
SALT_LENGTH=256
JWT_SECRET="REPLACE_ME_this_is_an_example_not_a_real_secret"
JWT_EXPIRES_IN_ACCESS="1h"
JWT_EXPIRES_IN_REFRESH="1d"
API_URL="http://localhost:3000"
DATABASE_URL="file:./dev.db"
EXECUTION_ALLOWED="true"
EXECUTION_TIMELIMIT_MS="5000" # 5 seconds
EXECUTION_MEMORYLIMIT_MB="128m" # 128 MB
EXEUCTION_CPULIMIT_PERCENT="0.5" # 50% of CPU
#DATABASE_PROVIDER="sqlite" # NEED TO MODIFY schema.prisma directly!!

# DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/mydb?schema=public"
